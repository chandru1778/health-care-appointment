{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "destination": "/stitch_medislot_ai_appointment_system/index.html"
    },
    {
      "source": "/((?!stitch_medislot_ai_appointment_system|api).*)",
      "destination": "/stitch_medislot_ai_appointment_system/$1"
    }
  ]
}
