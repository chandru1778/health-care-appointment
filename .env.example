# ==============================================================================
# MediZap Environment Configuration
# ==============================================================================

# Supabase Credentials (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Optional Server-side Service Role Key
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Google Gemini AI Triage (Optional - smart fallback triage runs if empty)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Port
PORT=3000
